{
  "name": "JourneyMilestone",
  "type": "object",
  "properties": {
    "household_code": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "eligibility",
        "application",
        "biometrics",
        "interview",
        "decision",
        "renewal",
        "citizenship",
        "other"
      ],
      "default": "application"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "done"
      ],
      "default": "pending"
    },
    "target_date": {
      "type": "string",
      "format": "date"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "order_index": {
      "type": "number",
      "default": 0
    },
    "case_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "shared": {
      "type": "boolean",
      "default": false
    },
    "workspace_id": {
      "type": "string"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "household_code",
    "title",
    "stage"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.members": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.members": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.members": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}