{
  "name": "EmergencyPlan",
  "type": "object",
  "properties": {
    "household_code": {
      "type": "string"
    },
    "meeting_place": {
      "type": "string"
    },
    "backup_place": {
      "type": "string"
    },
    "plan_notes": {
      "type": "string"
    },
    "allergies": {
      "type": "string"
    },
    "medications": {
      "type": "string"
    },
    "conditions": {
      "type": "string"
    },
    "blood_type": {
      "type": "string"
    },
    "children_info": {
      "type": "string"
    },
    "shared": {
      "type": "boolean",
      "default": false
    },
    "workspace_id": {
      "type": "string"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "household_code"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.members": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.members": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.members": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}